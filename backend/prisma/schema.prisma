generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum AuthProvider {
  KAKAO
  GUEST
}

enum Sensitivity {
  COLD
  NORMAL
  HOT
}

enum ClothingType {
  SHORT_SLEEVE
  LONG_SLEEVE
  SHIRT
  SHORT_SLEEVE_SHIRT
  SWEATSHIRT
  KNIT
  HOODIE
  PANTS
  SHORTS
  SKIRT
  WINDBREAKER
  JACKET
  CARDIGAN
  COAT
  PADDING
}

enum Thickness {
  THIN
  NORMAL
  THICK
}

enum ClothingColor {
  BLACK
  GRAY
  WHITE
  BEIGE
  GREEN
  BLUE
  OTHER
  NAVY
  SKYBLUE
  BROWN
  KHAKI
  RED
  PINK
  ORANGE
  YELLOW
  PURPLE
}

enum ClothingPattern {
  SOLID
  CHECK
  STRIPE
  DOT
  PRINT
}

enum ClothingCategory {
  TOP
  BOTTOM
  LIGHT_OUTER
  HEAVY_OUTER
}

// COMMUTE/EXERCISE 는 예전 값(이제 일정이 아니라 하루 패턴으로 다룸). 기존 행은 OTHER 로 옮겼고 새로 쓰지 않는다.
enum EventKind {
  TRAVEL
  CAMPING
  COMMUTE
  EXERCISE
  OTHER
  HIKING
  OUTDOOR
}

// 일정에 대해 사용자가 고른 옷차림 분위기(코디 도우미). 없으면 날씨만 보고 고른다
enum EventOutfitStyle {
  FORMAL
  SMART
  CASUAL
  COMFORT
}

enum ForecastStage {
  WAITING
  MIDTERM
  SHORTTERM
}

enum FeedbackRating {
  COLD
  OK
  HOT
}

enum FeedbackPeriod {
  MORNING
  DAY
  EVENING
}

enum LogStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum NotifyStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id             String  @id @default(uuid()) @db.Uuid
  plan           Plan    @default(FREE)
  onboardingDone Boolean @default(false)

  sensitivity    Sensitivity @default(NORMAL)
  feedbackOffset Float       @default(0) // 기온대별 보정의 단순 평균(예전 값). 실제 추천은 feedbackBandsJson 을 쓴다
  // 기온대별 피드백 보정(℃): { low, mid, high }. 비어 있으면 0
  feedbackBandsJson Json @default("{}")

  locationName   String  @default("서울 마포구")
  regionSido     String?
  regionDistrict String?
  latitude       Float?
  longitude      Float?
  gridNx         Int?
  gridNy         Int?

  // 하루 패턴(출근/등교·퇴근/하교 시간, 요일, 운동·산책 시간). 모르면 null
  routineOutAt  String? // 외출 시간 HH:mm
  routineHomeAt String? // 들어오는 시간 HH:mm
  routineDays   Int[]   @default([1, 2, 3, 4, 5]) // 0=일 ~ 6=토

  notifyEvent  Boolean @default(true)
  notifyChange Boolean @default(true)
  // 푸시 종류별 설정 (일정 알림 2종은 위의 notifyEvent / notifyChange)
  notifyMorning    Boolean @default(true) // 아침 오늘의 옷차림
  notifyRain       Boolean @default(true) // 우산 알림
  notifyColdReturn Boolean @default(true) // 귀가 때 추워질 때
  notifyDust       Boolean @default(false) // 미세먼지 나쁨
  notifyFeedback   Boolean @default(true) // 귀가 후 후기 요청
  notifyCloset     Boolean @default(false) // 옷장 리마인드(주 1회)
  notifyNotice     Boolean @default(true) // 운영 공지
  morningLeadMin   Int     @default(30) // 아침 알림: 외출 몇 분 전
  // 방해금지 시간(HH:mm, 한국 시간). 시작이 끝보다 늦으면 자정을 넘기는 구간(예: 23:00~07:00)
  quietEnabled Boolean @default(true)
  quietStart   String  @default("23:00")
  quietEnd     String  @default("07:00")

  // 내 캐릭터 꾸미기: { hat, hairpin, glasses, neck, extra } 각 슬롯의 아이템 id (없으면 비어 있음)
  characterJson Json @default("{}")
  isAdmin      Boolean @default(false)

  // 접속 기록(KST 기준 서로 다른 날 수)과 후기 요청 카드 상태. 후기는 사용자당 한 번만 받는다.
  lastSeenAt        DateTime?
  activeDays        Int       @default(1)
  reviewSnoozeUntil DateTime? // 나중에 하기: 이 시각 전에는 카드를 다시 보여주지 않는다
  reviewSnoozeCount Int       @default(0)
  reviewDismissed   Boolean   @default(false) // 다시 안 볼래요(또는 나중에를 두 번 누름)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  identities          AuthIdentity[]
  clothes             Clothing[]
  events              Event[]
  calendarConnections CalendarConnection[]
  recommendations     Recommendation[]
  feedbacks           Feedback[]
  pushSubscriptions   PushSubscription[]
  notifyLogs          NotifyLog[]
  aiCallLogs          AiCallLog[]
  favorites           FavoritePlace[]
  appReview           AppReview?
  supportMessages     SupportMessage[]
}

// 앱 후기(사용자당 한 번). 추천에 대한 피드백(Feedback)과는 다른 것이다.
model AppReview {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  rating    Int // 1~5
  message   String    @default("")
  readAt    DateTime? // 관리자가 읽음 표시한 시각
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

enum SupportKind {
  BUG // 불편하거나 이상해요
  IDEA // 있으면 좋겠어요
  OTHER
}

// 사용 중 떠오른 불편·제안(여러 번 보낼 수 있다). 한 번만 받는 앱 후기(AppReview)와 다르다.
model SupportMessage {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  kind      SupportKind @default(OTHER)
  message   String
  readAt    DateTime? // 관리자가 읽음 표시한 시각
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

// 사용자가 담아둔 지역(즐겨찾기). 좌표/격자를 미리 저장해서 누르면 바로 날씨를 볼 수 있다.
model FavoritePlace {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  name           String
  address        String
  latitude       Float
  longitude      Float
  gridNx         Int
  gridNy         Int
  regionSido     String?
  regionDistrict String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerUserId  String
  email           String?
  nickname        String?
  profileImageUrl String?
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Clothing {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  type       ClothingType
  thickness  Thickness
  color      ClothingColor
  category   ClothingCategory
  warmth     Float
  windproof  Boolean          @default(false)
  waterproof Boolean          @default(false)
  pattern    ClothingPattern  @default(SOLID)
  isSample   Boolean          @default(false) // 온보딩 예시 옷. 사용자가 확인/수정하기 전에는 추천에서 '내 옷'으로 쓰지 않는다
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model Event {
  id      String    @id @default(uuid()) @db.Uuid
  userId  String    @db.Uuid
  title   String
  kind    EventKind
  startAt DateTime
  endAt   DateTime

  placeName      String  @default("")
  regionSido     String?
  regionDistrict String?
  latitude       Float?
  longitude      Float?
  gridNx         Int?
  gridNy         Int?

  // 코디 도우미에서 고른 분위기. 일정 추천이 보온 조건을 만족하는 조합 중 이 분위기에 가까운 옷을 고른다
  outfitStyle           EventOutfitStyle?
  // 며칠짜리 일정에서 말로 정한 원하는 옷(색/톤/종류, 겉옷 없이 등). 날짜별 코디가 날마다 다르게 이 조건을 따른다. 없으면 null
  outfitWish            Json?
  forecastStage         ForecastStage @default(WAITING)
  recommendationVersion Int           @default(0)
  lastDecisionKey       String?
  lastCheckedAt         DateTime?
  notificationCount     Int           @default(0)

  // 외부 캘린더(iCal)에서 가져온 일정이면 연결과 원본 UID 를 가진다. 직접 입력한 일정은 둘 다 null.
  calendarConnectionId String? @db.Uuid
  externalUid          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  calendar        CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: Cascade)

  @@unique([calendarConnectionId, externalUid])
  @@index([userId, startAt])
  @@index([forecastStage, startAt])
}

/// 사용자가 연동한 외부 캘린더(구글/애플/삼성 등의 iCal 구독 주소). 해제하면 가져온 일정도 함께 지워진다.
model CalendarConnection {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  // GOOGLE | APPLE | SAMSUNG | OTHER
  provider     String
  icalUrl      String
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([userId, icalUrl])
  @@index([userId])
}

model ForecastSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  gridNx    Int
  gridNy    Int
  // KMA_SHORT | KMA_MID
  source    String
  issuedAt  DateTime
  fetchedAt DateTime @default(now())
  targetAt  DateTime

  temperature              Float
  feelsLike                Float?
  tempMin                  Float?
  tempMax                  Float?
  precipitationProbability Int?
  precipitationType        String?
  windSpeed                Float?
  humidity                 Float?
  sky                      String?

  createdAt DateTime @default(now())

  @@unique([gridNx, gridNy, source, issuedAt, targetAt])
  @@index([gridNx, gridNy, targetAt])
}

model AirQuality {
  id          String   @id @default(uuid()) @db.Uuid
  region      String
  stationName String?
  fetchedAt   DateTime @default(now())
  pm10        Int?
  pm25        Int?
  pm10Grade   Int?
  pm25Grade   Int?
  createdAt   DateTime @default(now())

  @@index([region, fetchedAt])
}

model Recommendation {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  eventId       String?  @db.Uuid
  targetStartAt DateTime
  targetEndAt   DateTime
  resultJson    Json
  reasonCodes   Json
  decisionKey   String
  version       Int      @default(1)
  aiExplanation String?
  // 설명을 만들 때의 조건과 종류({ source: ai/template, basis }). 지금 조건과 다르면 AI 문장 대신 템플릿을 보여 주는 데 쓴다. 예전 행은 비어 있다.
  aiExplanationMeta Json?
  createdAt     DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  feedbacks Feedback[]

  @@index([userId, targetStartAt])
  @@index([eventId])
}

model Feedback {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  recommendationId  String          @db.Uuid
  rating            FeedbackRating
  period            FeedbackPeriod?
  actualTemperature Float?
  // 추천대로 입었는지. 다른 옷을 입고 남긴 후기는 기록만 하고 보정에는 쓰지 않는다
  followed          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CollectLog {
  id         String    @id @default(uuid()) @db.Uuid
  job        String
  target     String?
  status     LogStatus
  message    String?
  durationMs Int?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model NotifyLog {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  eventId   String?      @db.Uuid
  status    NotifyStatus
  message   String?
  // 알림 종류(EVENT_FIRST/EVENT_CHANGE/MORNING/RAIN/COLD_RETURN/DUST/FEEDBACK/CLOSET/NOTICE)와, 같은 알림의 중복 발송을 막는 키(예: MORNING:2026-10-05)
  kind      String       @default("EVENT")
  dedupeKey String?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([createdAt])
}

model AiCallLog {
  id         String    @id @default(uuid()) @db.Uuid
  model      String
  status     LogStatus
  fallback   Boolean   @default(false)
  durationMs Int?
  message    String?
  // 누가 어떤 종류(photo/text)로 불렀는지. 하루 사용량 한도를 세는 데 쓴다. 예전 기록과 요청 밖 호출은 비어 있다.
  userId     String?   @db.Uuid
  // 탈퇴하면 DB 가 userId 를 비운다(SET NULL). 호출 기록은 서버 전체 상한·관리자 집계를 위해 익명으로 남는다.
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind       String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([userId, kind, createdAt])
}

// connect-pg-simple 세션 저장소 (테이블명 'session' 고정)
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
