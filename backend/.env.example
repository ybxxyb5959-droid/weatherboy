NODE_ENV=development
PORT=4000

# postgresql://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=

FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=

KAKAO_REST_API_KEY=
KAKAO_LOCAL_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:4000/api/auth/kakao/callback

KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=

TZ=Asia/Seoul

# 화면 파일(frontend/dist)을 서버가 직접 서비스할 때(개인/베타 배포). 비우면 Nginx 등이 따로 서비스한다.
SERVE_FRONTEND_DIR=

# true 면 알림/수집 작업을 API 프로세스 안에서 같이 돌린다(서버 1개만 쓰는 무료 호스팅용). 별도 worker 를 따로 돌린다면 false.
RUN_JOBS_IN_API=false
